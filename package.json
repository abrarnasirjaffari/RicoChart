{
  "name": "rico-chart-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "RicoChart — AI-first charting engine, event-driven alert watchdogs, pure-code execution, no-look-ahead backtester, live paper trading, news & macro events, and market connectors.",
  "license": "MIT",
  "author": "RICO",
  "homepage": "https://github.com/abrarnasirjaffari/RicoChart#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abrarnasirjaffari/RicoChart.git"
  },
  "bugs": {
    "url": "https://github.com/abrarnasirjaffari/RicoChart/issues"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "npm run clean --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "build:chart": "npm run build --workspace=packages/chart",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "test:chart": "npm run test --workspace=packages/chart",
    "lint": "npm run lint --workspace=packages/chart && eslint ."
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "12.1.2",
    "eslint": "^9.39.5",
    "rimraf": "6.1.4",
    "rollup": "^4.62.5",
    "rollup-plugin-dts": "6.1.1",
    "tslib": "2.8.1",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.6"
    }
  }
}
