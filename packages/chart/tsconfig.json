{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "useDefineForClassFields": true,
    "sourceMap": true,
    "paths": {
      "rico-chart": ["./src/index.ts"],
      "rico-chart/transform": ["./src/transform/index.ts"],
      "rico-chart/profile": ["./src/profile/index.ts"],
      "rico-chart/draw": ["./src/draw/index.ts"],
      "rico-chart/webgl": ["./src/webgl/index.ts"],
      "rico-chart/widget": ["./src/widget/index.ts"],
      "rico-chart/workspace": ["./src/workspace/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
