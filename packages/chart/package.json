{
  "name": "rico-chart",
  "version": "1.0.0",
  "private": true,
  "description": "RicoChart — AI-first, dependency-free canvas & WebGL2 charting and market analysis engine.",
  "license": "MIT",
  "author": "RICO",
  "homepage": "https://github.com/abrarnasirjaffari/RicoChart#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abrarnasirjaffari/RicoChart.git"
  },
  "bugs": {
    "url": "https://github.com/abrarnasirjaffari/RicoChart/issues"
  },
  "keywords": [
    "charts",
    "charting",
    "candlestick",
    "trading",
    "finance",
    "canvas",
    "ricochart",
    "rico",
    "ai-charts",
    "technical-analysis",
    "drawing-tools",
    "footprint",
    "renko",
    "heikin-ashi",
    "widget"
  ],
  "type": "module",
  "module": "dist/rico-chart.mjs",
  "unpkg": "dist/rico-chart.standalone.js",
  "jsdelivr": "dist/rico-chart.standalone.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/rico-chart.mjs",
      "default": "./dist/rico-chart.mjs"
    },
    "./transform": {
      "types": "./dist/transform/index.d.ts",
      "import": "./dist/rico-chart.transform.mjs",
      "default": "./dist/rico-chart.transform.mjs"
    },
    "./profile": {
      "types": "./dist/profile/index.d.ts",
      "import": "./dist/rico-chart.profile.mjs",
      "default": "./dist/rico-chart.profile.mjs"
    },
    "./draw": {
      "types": "./dist/draw/index.d.ts",
      "import": "./dist/rico-chart.draw.mjs",
      "default": "./dist/rico-chart.draw.mjs"
    },
    "./webgl": {
      "types": "./dist/webgl/index.d.ts",
      "import": "./dist/rico-chart.webgl.mjs",
      "default": "./dist/rico-chart.webgl.mjs"
    },
    "./workspace": {
      "types": "./dist/workspace/index.d.ts",
      "import": "./dist/rico-chart.workspace.mjs",
      "default": "./dist/rico-chart.workspace.mjs"
    },
    "./widget": {
      "types": "./dist/widget/index.d.ts",
      "import": "./dist/rico-chart.widget.mjs",
      "default": "./dist/rico-chart.widget.mjs"
    }
  },
  "files": [
    "dist/**",
    "!dist/rico-chart.all.mjs",
    "!dist/rico-chart.all.mjs.map"
  ],
  "sideEffects": [
    "**/transform/**",
    "**/draw/**",
    "**/webgl/**",
    "**/widget/**",
    "./dist/rico-chart.transform.mjs",
    "./dist/rico-chart.draw.mjs",
    "./dist/rico-chart.webgl.mjs",
    "./dist/rico-chart.widget.mjs"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "rimraf dist && node --max-old-space-size=4096 ../../node_modules/rollup/dist/bin/rollup -c",
    "build:watch": "rollup -c --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "12.1.2",
    "eslint": "^9.39.5",
    "rimraf": "6.1.4",
    "rollup": "^4.62.5",
    "rollup-plugin-dts": "6.1.1",
    "tslib": "2.8.1",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.6"
    }
  }
}
